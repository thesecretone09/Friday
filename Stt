"""
Speech-to-Text — runs 100% locally on your GPU via faster-whisper.
Your voice audio never leaves your computer.
"""

import numpy as np
import sounddevice as sd
from faster_whisper import WhisperModel

import config


class SpeechListener:
    def __init__(self):
        print(f"[STT] Loading Whisper model '{config.WHISPER_MODEL_SIZE}' on {config.WHISPER_DEVICE}...")
        try:
            self.model = WhisperModel(
                config.WHISPER_MODEL_SIZE,
                device=config.WHISPER_DEVICE,
                compute_type=config.WHISPER_COMPUTE_TYPE,
            )
        except Exception as e:
            print(f"[STT] GPU load failed ({e}), falling back to CPU.")
            self.model = WhisperModel(config.WHISPER_MODEL_SIZE, device="cpu", compute_type="int8")
        print("[STT] Ready.")

    def record_audio(self, seconds=None) -> np.ndarray:
        seconds = seconds or config.RECORD_SECONDS
        print(f"[STT] Listening for {seconds}s...")
        audio = sd.rec(
            int(seconds * config.SAMPLE_RATE),
            samplerate=config.SAMPLE_RATE,
            channels=1,
            dtype="float32",
        )
        sd.wait()
        return audio.flatten()

    def transcribe(self, audio: np.ndarray) -> str:
        segments, _ = self.model.transcribe(audio, language="en")
        text = " ".join(seg.text.strip() for seg in segments)
        return text.strip()

    def listen_and_transcribe(self, seconds=None) -> str:
        audio = self.record_audio(seconds)
        text = self.transcribe(audio)
        return text
